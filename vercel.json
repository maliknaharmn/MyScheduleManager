{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "fluid": true,
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "runtime": "python",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 60,
          "regions": ["sin1"],
          "excludeFiles": "{.env*,.venv/**,.local/**,tests/**,scripts/**,alembic/**,requirements-dev.lock,**/__pycache__/**,src/myschedule/local_preview.py,src/myschedule/local-login.html}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/.*", "dest": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/health/:path*", "destination": { "service": "backend" } },
    { "source": "/:path*", "destination": { "service": "frontend" } }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "git": { "deploymentEnabled": false }
}
