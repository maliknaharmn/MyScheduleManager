# Copy to .env or use scripts/provision_local.py. Never commit the real .env.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://myschedule_app:CHANGE_ME@127.0.0.1:5432/myschedule_dev
AUTH_DATABASE_URL=postgresql+asyncpg://myschedule_auth:CHANGE_ME@127.0.0.1:5432/myschedule_dev
MIGRATION_DATABASE_URL=postgresql+asyncpg://OWNER@/myschedule_dev?host=/tmp
TEST_DATABASE_URL=postgresql+asyncpg://myschedule_app:CHANGE_ME@127.0.0.1:5432/myschedule_test
TEST_AUTH_DATABASE_URL=postgresql+asyncpg://myschedule_auth:CHANGE_ME@127.0.0.1:5432/myschedule_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://OWNER@/myschedule_test?host=/tmp
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI in Google Cloud (the browser uses the Vite proxy).
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
